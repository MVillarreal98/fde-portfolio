<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless runner over the same engine and fail-closed run as the WPF app
       (used to regenerate sample_output/ and for scripted runs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FileLayoutAutomator.csproj" />
  </ItemGroup>

</Project>
