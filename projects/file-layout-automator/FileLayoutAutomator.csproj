<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DocumentLayoutAutomator</AssemblyName>
    <RootNamespace>DocumentLayoutAutomator</RootNamespace>
  </PropertyGroup>

  <!-- The xunit test project owns tests/ and the console runner owns tools/;
       the app does not compile either. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <None Remove="tests/**/*.csproj" />
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

</Project>
